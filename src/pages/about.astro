---
import Layout from '../Layouts/Layouts.astro';
import restaurant from '../data/resturant.json';
---

<Layout
  title={`About Us | ${restaurant.name}`}
  description={`Learn about the food, hospitality, and ingredients behind ${restaurant.name} in ${restaurant.address.city}.`}
>
  <section class="about-section">
    <div class="about-grid">
      <div class="image-wrap">
        <img
          class="restaurant-image"
          src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=1200&q=85"
          alt={`Dining room at ${restaurant.name}`}
          loading="eager"
        />
        <div class="experience-card">
          <span class="experience-number">10<span>+</span></span>
          <span>Years of<br />experience</span>
        </div>
      </div>

      <div class="about-copy">
        <span class="eyebrow">Welcome to {restaurant.name}</span>
        <h1>Good Food,<br />Good <em>Life</em></h1>
        <p>
          At {restaurant.name}, we believe great food brings people together.
          Inspired by authentic flavours and crafted with fresh ingredients,
          every meal is an invitation to slow down, share, and enjoy.
        </p>
        <p>
          From our kitchen to your table in {restaurant.address.city}, we pair
          thoughtful cooking with the warm hospitality that makes every visit
          feel special.
        </p>
        <a class="learn-more" href="/menu">
          Explore our menu <span aria-hidden="true">→</span>
        </a>
      </div>

      <ul class="qualities" aria-label="What makes us special">
        <li class="quality">
          <span class="quality-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
              <path d="M16 26V13m0 7c-5 0-8-3-8-8 5 0 8 3 8 8Zm0-4c0-5 3-8 8-8 0 5-3 8-8 8Zm-8 9h16" />
            </svg>
          </span>
          <span><strong>Quality</strong><small>Fresh ingredients</small></span>
        </li>
        <li class="quality">
          <span class="quality-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
              <path d="M8 18v-6a8 8 0 0 1 16 0v6M8 17H5v5h5v-5H8Zm16 0h3v5h-5v-5h2ZM11 26h10" />
              <path d="M12 12v4m4-6v6m4-4v4" />
            </svg>
          </span>
          <span><strong>Skilled chefs</strong><small>Made with care</small></span>
        </li>
        <li class="quality">
          <span class="quality-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
              <path d="M7 14 16 7l9 7v12H7V14Z" />
              <path d="M13 26v-8h6v8m-3-14v3m-2-1h4" />
            </svg>
          </span>
          <span><strong>Cozy ambience</strong><small>A place to unwind</small></span>
        </li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .about-section {
    padding: clamp(4rem, 8vw, 7rem) 1.5rem;
    background: #fffdfa;
  }

  .about-grid {
    width: min(100%, 1200px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(250px, 0.9fr) minmax(170px, 0.55fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4.5rem);
  }

  .image-wrap {
    position: relative;
    min-width: 0;
  }

  .restaurant-image {
    display: block;
    width: 100%;
    height: clamp(310px, 34vw, 440px);
    object-fit: cover;
    border-radius: 20px;
    box-shadow: 0 18px 42px rgba(48, 34, 22, 0.12);
  }

  .experience-card {
    position: absolute;
    right: -14px;
    bottom: 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    padding: 18px 21px;
    border-radius: 14px;
    background: #d9652d;
    color: #fff;
    text-align: center;
    font-size: 0.78rem;
    line-height: 1.35;
    box-shadow: 0 12px 26px rgba(164, 75, 35, 0.25);
  }

  .experience-number {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
  }

  .experience-number span {
    font-size: 1.2rem;
  }

  .about-copy {
    max-width: 390px;
  }

  .eyebrow {
    color: #d9652d;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .about-copy h1 {
    margin: 0.9rem 0 1rem;
    color: #1d211c;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.04;
  }

  .about-copy h1 em {
    color: #d9652d;
    font-weight: 500;
  }

  .about-copy p {
    margin: 0 0 0.9rem;
    color: #6a6862;
    font-size: 0.94rem;
    line-height: 1.8;
  }

  .learn-more {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding: 0.85rem 1.15rem;
    border-radius: 6px;
    background: #263d19;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .learn-more:hover {
    background: #1b2e11;
    transform: translateY(-2px);
  }

  .learn-more span {
    font-size: 1rem;
  }

  .qualities {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .quality {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .quality-icon {
    display: grid;
    width: 58px;
    height: 58px;
    flex: 0 0 58px;
    place-items: center;
    border: 1px solid #f0e9df;
    border-radius: 50%;
    background: #faf6ef;
    color: #405736;
  }

  .quality-icon svg {
    width: 30px;
    height: 30px;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .quality strong,
  .quality small {
    display: block;
  }

  .quality strong {
    color: #292a25;
    font-size: 0.88rem;
  }

  .quality small {
    margin-top: 0.25rem;
    color: #77736c;
    font-size: 0.77rem;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .qualities {
      grid-column: 1 / -1;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .quality {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 600px) {
    .about-section {
      padding: 3.5rem 1.15rem;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .restaurant-image {
      height: 290px;
    }

    .experience-card {
      right: -7px;
    }

    .about-copy {
      max-width: none;
    }

    .qualities {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .quality {
      flex-direction: row;
      align-items: center;
    }
  }
</style>