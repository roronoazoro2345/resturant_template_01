---
import Layout from '../Layouts/Layouts.astro';
import restaurant from '../data/resturant.json';
import menu from '../data/menu.json';
---

<Layout
  title={`Our Menu | ${restaurant.name}`}
  description={`Explore the food and beverage menu at ${restaurant.name}.`}
>
  <section class="menu-page">
    <header class="menu-heading">
      <span class="eyebrow">Fresh & authentic</span>
      <h1>A menu made<br />for <em>sharing</em></h1>
      <p>Thoughtful recipes, fresh ingredients, and something delicious for everyone.</p>
    </header>

    <nav class="category-nav" aria-label="Menu categories">
      {menu.map((category, index) => (
        <a href={`#category-${index}`}>{category.category}</a>
      ))}
    </nav>

    <div class="categories">
      {menu.map((category, index) => (
        <section class="category" id={`category-${index}`}>
          <div class="category-heading">
            <span class="category-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h2>{category.category}</h2>
              <p>Prepared fresh in our kitchen</p>
            </div>
          </div>
          <div class="item-grid">
            {category.items.map((item) => (
              <article class="menu-item">
                <div class="item-title">
                  <span class:list={['diet-indicator', item.isVeg ? 'veg' : 'nonveg']} aria-label={item.isVeg ? 'Vegetarian' : 'Non-vegetarian'}></span>
                  <h3>{item.name}</h3>
                  <span class="item-price">{item.price}</span>
                </div>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>

    <aside class="menu-cta">
      <div>
        <span class="eyebrow">Save your seat</span>
        <h2>Good food tastes better together.</h2>
        <p>Join us in {restaurant.address.city} for your next meal.</p>
      </div>
      <a href="/contact#book">Reserve a table <span aria-hidden="true">→</span></a>
    </aside>
  </section>
</Layout>

<style>
  :global(body) { background: #fffdfa; }
  .menu-page { width: min(100% - 3rem, 1020px); margin: 0 auto; padding: 4.5rem 0 5rem; }
  .menu-heading { max-width: 650px; margin: 0 auto 2.25rem; text-align: center; }
  .eyebrow { color: #d9652d; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.15em; text-transform: uppercase; }
  .menu-heading h1 { margin: 0.75rem 0; color: #1d211c; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2.8rem, 7vw, 4.3rem); font-weight: 600; letter-spacing: -0.055em; line-height: 1.02; }
  .menu-heading h1 em { color: #d9652d; font-weight: 500; }
  .menu-heading p, .category-heading p { color: #77736c; font-size: 0.9rem; line-height: 1.7; }
  .category-nav { display: flex; justify-content: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 3.5rem; }
  .category-nav a { padding: 0.65rem 1rem; border: 1px solid #e8dfd3; border-radius: 999px; color: #4a463e; font-size: 0.76rem; font-weight: 700; text-decoration: none; transition: background 160ms ease, color 160ms ease; }
  .category-nav a:hover { border-color: #d9652d; background: #d9652d; color: #fff; }
  .categories { display: grid; gap: 3.2rem; }
  .category { scroll-margin-top: 130px; }
  .category-heading { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.2rem; padding-bottom: 1rem; border-bottom: 1px solid #e9e3da; }
  .category-number { color: #d9652d; font-family: Georgia, 'Times New Roman', serif; font-size: 2rem; }
  .category-heading h2 { margin: 0; color: #24251f; font-family: Georgia, 'Times New Roman', serif; font-size: 1.8rem; }
  .category-heading p { margin: 0.2rem 0 0; font-size: 0.78rem; }
  .item-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2.5rem; }
  .menu-item { padding: 1.15rem 0; border-bottom: 1px dashed #e6ded2; }
  .item-title { display: flex; align-items: center; gap: 0.65rem; }
  .item-title h3 { flex: 1; margin: 0; color: #292a25; font-family: Georgia, 'Times New Roman', serif; font-size: 1rem; }
  .diet-indicator { display: grid; width: 14px; height: 14px; flex: 0 0 14px; place-items: center; border: 1px solid #b74839; border-radius: 2px; }
  .diet-indicator::after { width: 6px; height: 6px; border-radius: 50%; background: #b74839; content: ''; }
  .diet-indicator.veg { border-color: #47723b; }
  .diet-indicator.veg::after { background: #47723b; }
  .item-price { color: #d9652d; font-size: 0.88rem; font-weight: 800; white-space: nowrap; }
  .menu-item p { margin: 0.55rem 0 0 1.4rem; color: #77736c; font-size: 0.8rem; line-height: 1.6; }
  .menu-cta { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 4rem; padding: 2rem clamp(1.25rem, 4vw, 3rem); border-radius: 16px; background: #f7f1e8; }
  .menu-cta h2 { margin: 0.5rem 0; color: #20231c; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.5rem, 3vw, 2rem); }
  .menu-cta p { margin: 0; color: #77736c; font-size: 0.86rem; }
  .menu-cta > a { display: inline-flex; align-items: center; gap: 0.6rem; flex: 0 0 auto; padding: 0.9rem 1.15rem; border-radius: 6px; background: #d9652d; color: #fff; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.06em; text-decoration: none; text-transform: uppercase; }
  .menu-cta > a:hover { background: #bd5125; }
  @media (max-width: 620px) {
    .menu-page { width: min(100% - 2.25rem, 1020px); padding: 3rem 0; }
    .item-grid { grid-template-columns: 1fr; }
    .category-heading h2 { font-size: 1.5rem; }
    .menu-cta { align-items: flex-start; flex-direction: column; }
  }
</style>
