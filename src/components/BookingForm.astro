---
import resturant from '../data/resturant.json';
---

<form
  id="booking-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  class="mx-auto max-w-xl space-y-5 rounded-2xl border border-stone-200 bg-white p-6 shadow-[0_12px_32px_rgba(66,48,27,0.08)] sm:p-8"
>
  <input type="hidden" name="access_key" value={resturant.web3forms_key} />
  <input type="hidden" name="subject" value={`New Table Booking Request - ${resturant.name}`} />
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

  <div>
    <label for="booking-name" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-stone-600">Full Name</label>
    <input id="booking-name" type="text" name="name" required autocomplete="name" placeholder="John Doe" class="w-full rounded-lg border border-stone-300 bg-white px-4 py-3 text-sm text-stone-800 outline-none transition placeholder:text-stone-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20" />
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label for="booking-phone" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-stone-600">Phone Number</label>
      <input id="booking-phone" type="tel" name="phone" required autocomplete="tel" placeholder="+91 98765 43210" class="w-full rounded-lg border border-stone-300 bg-white px-4 py-3 text-sm text-stone-800 outline-none transition placeholder:text-stone-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20" />
    </div>
    <div>
      <label for="booking-guests" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-stone-600">Guests</label>
      <select id="booking-guests" name="guests" class="w-full rounded-lg border border-stone-300 bg-white px-4 py-3 text-sm text-stone-800 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20">
        <option value="2">2 Guests</option>
        <option value="4">4 Guests</option>
        <option value="6">6 Guests</option>
        <option value="8+">8+ Guests (Large Party)</option>
      </select>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label for="booking-date" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-stone-600">Date</label>
      <input id="booking-date" type="date" name="date" required class="w-full rounded-lg border border-stone-300 bg-white px-4 py-3 text-sm text-stone-800 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20" />
    </div>
    <div>
      <label for="booking-time" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-stone-600">Preferred Time</label>
      <input id="booking-time" type="time" name="time" required class="w-full rounded-lg border border-stone-300 bg-white px-4 py-3 text-sm text-stone-800 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20" />
    </div>
  </div>

  <div>
    <label for="booking-notes" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-stone-600">Special Notes <span class="font-normal normal-case tracking-normal text-stone-400">(Optional)</span></label>
    <textarea id="booking-notes" name="notes" rows="3" placeholder="Birthday celebration, high chair, window table..." class="w-full resize-y rounded-lg border border-stone-300 bg-white px-4 py-3 text-sm text-stone-800 outline-none transition placeholder:text-stone-400 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20"></textarea>
  </div>

  <div id="booking-captcha-container" class="hidden">
    <label for="booking-captcha-answer" class="mb-1.5 block text-sm font-semibold text-stone-700">
      Solve <span id="booking-captcha-question"></span>
    </label>
    <input id="booking-captcha-answer" type="number" inputmode="numeric" min="0" step="1" autocomplete="off" class="w-full rounded-lg border border-stone-300 bg-white px-4 py-3 text-sm text-stone-800 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20" />
  </div>
  <p id="booking-captcha-status" class="text-sm text-red-700" role="status" aria-live="polite"></p>

  <button type="submit" class="w-full rounded-lg bg-orange-700 px-6 py-3.5 text-sm font-bold uppercase tracking-wider text-white shadow-sm transition hover:bg-orange-800 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-600 focus-visible:ring-offset-2">
    Request a Reservation <span aria-hidden="true">→</span>
  </button>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#booking-form');
  const captchaContainer = document.querySelector<HTMLElement>('#booking-captcha-container');
  const captchaQuestion = document.querySelector<HTMLElement>('#booking-captcha-question');
  const captchaAnswer = document.querySelector<HTMLInputElement>('#booking-captcha-answer');
  const captchaStatus = document.querySelector<HTMLElement>('#booking-captcha-status');

  if (!form || !captchaContainer || !captchaQuestion || !captchaAnswer || !captchaStatus) {
    throw new Error('Booking form CAPTCHA elements could not be found.');
  }

  let expectedAnswer: number | undefined;
  let captchaVerified = false;

  form.addEventListener('submit', (event) => {
    if (captchaVerified) {
      return;
    }

    event.preventDefault();
    if (expectedAnswer === undefined) {
      const firstNumber = Math.floor(Math.random() * 9) + 1;
      const secondNumber = Math.floor(Math.random() * 9) + 1;
      const isAddition = Math.random() < 0.5;
      const largerNumber = Math.max(firstNumber, secondNumber);
      const smallerNumber = Math.min(firstNumber, secondNumber);
      const leftNumber = isAddition ? firstNumber : largerNumber;
      const rightNumber = isAddition ? secondNumber : smallerNumber;

      expectedAnswer = isAddition ? leftNumber + rightNumber : leftNumber - rightNumber;
      captchaQuestion.textContent = `${leftNumber} ${isAddition ? '+' : '−'} ${rightNumber} = ?`;
      captchaContainer.classList.remove('hidden');
      captchaAnswer.required = true;
      captchaStatus.textContent = 'Answer the question, then select Request a Reservation again.';
      captchaAnswer.focus();
      return;
    }

    if (Number(captchaAnswer.value) !== expectedAnswer) {
      captchaStatus.textContent = 'That answer is not correct. Please try again.';
      captchaAnswer.focus();
      captchaAnswer.select();
      return;
    }

    captchaVerified = true;
  });
</script>