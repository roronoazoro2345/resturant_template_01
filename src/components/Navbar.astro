---
import resturant from '../data/resturant.json';

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'About Us', href: '/about' },
  { name: 'Menu', href: '/menu' },
  { name: 'Reservation', href: '/contact#book' },
  { name: 'Gallery', href: '/gallery' },
  { name: 'Contact', href: '/contact' },
];
---

<header class="site-header">
 
  <div class="nav-shell">
    <a href="/" class="brand" aria-label="Home">
      <svg class="brand-mark" viewBox="0 0 56 56" aria-hidden="true">
        <circle cx="28" cy="28" r="26" class="brand-mark-outer" />
        <circle cx="28" cy="28" r="22" class="brand-mark-inner" />
        <path d="M37 18c-2.1-2.1-5.3-3.1-9-3.1-6.1 0-10 3.1-10 7.7 0 4 3 6.1 9.2 7.4l2.2.5c4.3.9 6.2 2 6.2 4.1 0 2.5-2.8 4.1-7.3 4.1-4 0-7.1-1.3-9.2-3.8" class="brand-mark-letter" />
        <path d="M30 30.2h4.2c4.1 0 6.5 2.1 6.5 5.3 0 3.3-2.5 5.5-6.7 5.5H30z" class="brand-mark-detail" />
        <circle cx="28" cy="8" r="1.5" class="brand-mark-dot" />
      </svg>
      <div class="brand-text">
        <span class="brand-name">The Spice Route</span>
        <span class="brand-sub">Bistro</span>
      </div>
    </a>

    <nav class="main-nav" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link">
          {link.name}
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href="/contact#book" class="book-btn">Book a Table</a>
      <button id="menu-btn" class="menu-btn" aria-label="Toggle menu" aria-controls="mobile-menu" aria-expanded="false" type="button">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu hidden">
    {navLinks.map((link) => (
      <a href={link.href} class="mobile-link">
        {link.name}
      </a>
    ))}
    <a href="/contact#book" class="mobile-book-btn">Book a Table</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(34, 34, 34, 0.08);
    box-shadow: 0 8px 20px rgba(18, 18, 18, 0.04);
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 64px;
    border-bottom: 1px solid rgba(33, 27, 23, 0.08);
    background: #f7f5f3;
    font-size: 0.76rem;
    color: #473d38;
    letter-spacing: 0.02em;
  }

  .topbar-item,
  .topbar-socials {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .center-item {
    justify-content: center;
    flex: 1;
  }

  .topbar-socials {
    gap: 10px;
    font-weight: 600;
    color: #413730;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid rgba(17, 17, 17, 0.08);
    color: #3f3a36;
    font-size: 0.68rem;
    font-weight: 700;
  }

  .nav-shell {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 28px 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-width: 0;
    text-decoration: none;
    color: #1c1c1c;
  }

  .brand-mark {
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    filter: drop-shadow(0 3px 5px rgba(62, 42, 27, 0.16));
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .brand:hover .brand-mark {
    transform: translateY(-2px);
    filter: drop-shadow(0 5px 7px rgba(62, 42, 27, 0.22));
  }

  .brand-mark-outer {
    fill: #30241f;
    stroke: #c9824d;
    stroke-width: 1.5;
  }

  .brand-mark-inner {
    fill: none;
    stroke: #e8c18d;
    stroke-width: 0.7;
  }

  .brand-mark-letter {
    fill: none;
    stroke: #f8efe2;
    stroke-width: 2.1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .brand-mark-detail {
    fill: none;
    stroke: #e8aa68;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .brand-mark-dot {
    fill: #e8aa68;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .brand-name {
    font-size: clamp(1.5rem, 2vw, 2rem);
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    white-space: nowrap;
    color: #30241f;
  }

  .brand-sub {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #a7542d;
  }

  .brand-sub::before,
  .brand-sub::after {
    content: '';
    width: 18px;
    height: 1px;
    background: #d7a47a;
  }

  .main-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    flex: 1;
  }

  .nav-link {
    position: relative;
    color: #2b2725;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: #d77a3d;
  }

  .nav-link.active::after,
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -12px;
    height: 2px;
    background: #d77a3d;
    border-radius: 999px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .book-btn,
  .mobile-book-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.4rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #df7d38, #c14c2a);
    color: #fff;
    text-decoration: none;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: none;
    box-shadow: 0 10px 18px rgba(215, 122, 61, 0.2);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .book-btn:hover,
  .mobile-book-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 22px rgba(215, 122, 61, 0.24);
  }

  .menu-btn {
    display: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(35, 35, 35, 0.12);
    background: #fff;
    color: #2b2725;
    cursor: pointer;
  }

  .menu-btn svg {
    width: 20px;
    height: 20px;
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0 1.25rem 1.25rem;
    background: #fff;
    border-top: 1px solid rgba(41, 38, 34, 0.08);
  }

  .mobile-menu:not(.hidden) {
    display: flex;
  }

  .mobile-link {
    padding: 0.8rem 0.25rem;
    text-decoration: none;
    color: #2b2725;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(41, 38, 34, 0.06);
  }

  .mobile-book-btn {
    margin-top: 0.5rem;
    width: 100%;
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 980px) {
    .topbar {
      padding-left: 20px;
      padding-right: 20px;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .topbar-item:nth-child(2) {
      order: 3;
      width: 100%;
      justify-content: center;
    }

    .main-nav {
      display: none;
    }

    .menu-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .nav-shell {
      padding: 16px 18px;
    }

    .brand-name {
      font-size: 1.28rem;
    }

    .brand-mark {
      flex-basis: 42px;
      width: 42px;
      height: 42px;
    }

    .brand-sub {
      letter-spacing: 0.28em;
    }

    .book-btn {
      display: none;
    }

    .topbar {
      font-size: 0.68rem;
      padding-top: 8px;
      padding-bottom: 8px;
    }
  }
</style>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden', isExpanded);
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>