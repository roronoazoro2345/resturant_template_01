---
import resturant from '../data/resturant.json';

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'About Us', href: '/about' },
  { name: 'Menu', href: '/menu' },
  { name: 'Reservation', href: '/contact#book' },
  { name: 'Gallery', href: '/gallery' },
  { name: 'Contact', href: '/contact' },
];
---

<header class="site-header">
 
  <div class="nav-shell">
    <a href="/" class="brand" aria-label="Home">
      <div class="brand-mark">
        <span class="brand-leaf leaf-one"></span>
        <span class="brand-leaf leaf-two"></span>
        <span class="brand-leaf leaf-three"></span>
      </div>
      <div class="brand-text">
        <span class="brand-name">Flavoria</span>
        <span class="brand-sub">RESTAURANT</span>
      </div>
    </a>

    <nav class="main-nav" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link">
          {link.name}
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href="/contact#book" class="book-btn">Book a Table</a>
      <button id="menu-btn" class="menu-btn" aria-label="Toggle menu" type="button">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu hidden">
    {navLinks.map((link) => (
      <a href={link.href} class="mobile-link">
        {link.name}
      </a>
    ))}
    <a href="/contact#book" class="mobile-book-btn">Book a Table</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(34, 34, 34, 0.08);
    box-shadow: 0 8px 20px rgba(18, 18, 18, 0.04);
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 64px;
    border-bottom: 1px solid rgba(33, 27, 23, 0.08);
    background: #f7f5f3;
    font-size: 0.76rem;
    color: #473d38;
    letter-spacing: 0.02em;
  }

  .topbar-item,
  .topbar-socials {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .center-item {
    justify-content: center;
    flex: 1;
  }

  .topbar-socials {
    gap: 10px;
    font-weight: 600;
    color: #413730;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid rgba(17, 17, 17, 0.08);
    color: #3f3a36;
    font-size: 0.68rem;
    font-weight: 700;
  }

  .nav-shell {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 28px 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #1c1c1c;
  }

  .brand-mark {
    position: relative;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f2ded4, #f9efe1);
    border: 1px solid rgba(221, 138, 70, 0.4);
    overflow: hidden;
  }

  .brand-leaf {
    position: absolute;
    display: block;
    width: 12px;
    height: 20px;
    background: linear-gradient(180deg, #d9f0d9, #6a8d61);
    border-radius: 40% 0 50% 0;
    transform-origin: center bottom;
  }

  .leaf-one {
    left: 9px;
    top: 8px;
    transform: rotate(-25deg);
  }

  .leaf-two {
    left: 16px;
    top: 4px;
    transform: rotate(20deg);
  }

  .leaf-three {
    left: 22px;
    top: 12px;
    transform: rotate(48deg);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-name {
    font-size: clamp(1.9rem, 2vw, 2.5rem);
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: #1c1a18;
  }

  .brand-sub {
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.26em;
    color: #d77a3d;
    margin-top: 4px;
  }

  .main-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    flex: 1;
  }

  .nav-link {
    position: relative;
    color: #2b2725;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: #d77a3d;
  }

  .nav-link.active::after,
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -12px;
    height: 2px;
    background: #d77a3d;
    border-radius: 999px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .book-btn,
  .mobile-book-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.4rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #df7d38, #c14c2a);
    color: #fff;
    text-decoration: none;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: none;
    box-shadow: 0 10px 18px rgba(215, 122, 61, 0.2);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .book-btn:hover,
  .mobile-book-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 22px rgba(215, 122, 61, 0.24);
  }

  .menu-btn {
    display: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(35, 35, 35, 0.12);
    background: #fff;
    color: #2b2725;
    cursor: pointer;
  }

  .menu-btn svg {
    width: 20px;
    height: 20px;
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0 1.25rem 1.25rem;
    background: #fff;
    border-top: 1px solid rgba(41, 38, 34, 0.08);
  }

  .mobile-link {
    padding: 0.8rem 0.25rem;
    text-decoration: none;
    color: #2b2725;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(41, 38, 34, 0.06);
  }

  .mobile-book-btn {
    margin-top: 0.5rem;
    width: 100%;
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 980px) {
    .topbar {
      padding-left: 20px;
      padding-right: 20px;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .topbar-item:nth-child(2) {
      order: 3;
      width: 100%;
      justify-content: center;
    }

    .main-nav {
      display: none;
    }

    .menu-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .nav-shell {
      padding: 16px 18px;
    }

    .brand-name {
      font-size: 1.5rem;
    }

    .brand-sub {
      letter-spacing: 0.18em;
    }

    .book-btn {
      display: none;
    }

    .topbar {
      font-size: 0.68rem;
      padding-top: 8px;
      padding-bottom: 8px;
    }
  }
</style>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>