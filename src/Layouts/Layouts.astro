---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import resturant from '../data/resturant.json';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = `${resturant.name} | ${resturant.tagline}`, 
  description = "Experience exquisite dining, freshly prepared gourmet dishes, and warm hospitality." 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-neutral-50 text-neutral-900 min-h-screen flex flex-col m-0 p-0 font-sans antialiased">
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>